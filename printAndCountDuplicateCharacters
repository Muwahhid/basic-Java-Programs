class Main {
    public static void main(String[] args) {
        //System.out.println("Try programiz.pro");
        String inputStr = "aabbckjhgyugfdsajsds";
        int charCount =0;
        char charName = inputStr.charAt(0);
        char[] newStr = inputStr.toCharArray();
        for(int i=0;i<newStr.length;i++)
        {
             charCount=1;
            char new1 = newStr[i];
            if(new1=='0')
            {
                continue;
            }
            for(int j=i+1;j<newStr.length;j++)
            {
            char new2 = newStr[j];
            if(new1 == new2)
            {
                charCount++;
                charName=new2;
                newStr[j]='0';
                //startChar = inputStr.charAt(i);
            }
        }
       if(charCount>1)
        {
           System.out.println("Count of Character '"+charName+"' : "+charCount);
        }
    }
}
}
